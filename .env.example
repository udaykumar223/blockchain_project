# ─── Sepolia Testnet Deployment ───
# Alchemy, Infura, or public RPC URL for Ethereum Sepolia:
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer private key with Sepolia testnet ETH (from MetaMask -> Account Details -> Export Private Key)
# ⚠️ NEVER use a key holding real funds!
SEPOLIA_PRIVATE_KEY=

# ─── Backend Cloud Configuration (Render) ───
PORT=5000
# For local dev: http://127.0.0.1:8545
# For Sepolia: https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=http://127.0.0.1:8545
REGISTRAR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=
